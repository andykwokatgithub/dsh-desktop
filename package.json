{
  "name": "@andykwok/dsh-desktop",
  "version": "0.3.2",
  "description": "A Go + WebView2 desktop shell for the DeepSeek Harness Web UI (dsh web). Prebuilt Windows x64 binary bundled in the package; no install script and no runtime download needed.",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "bin": {
    "dsh-desktop": "bin/dsh-desktop.mjs"
  },
  "files": [
    "bin/",
    "scripts/",
    "cordis.patch.yml",
    "dsh-desktop-win-x64.exe",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File build.ps1"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "desktop",
    "webview2",
    "shell",
    "windows",
    "gui",
    "plugin",
    "dsh-plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andykwokatgithub/dsh-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/andykwokatgithub/dsh-desktop/issues"
  },
  "homepage": "https://github.com/andykwokatgithub/dsh-desktop#readme"
}
